# Kopier denne filen til .env og fyll inn verdiene.

# --- Nettsiden ---
PORT=3000
# Den offentlige adressen til siden, uten / på slutten
BASE_URL=https://novexrp.no
# Sett til true når siden står bak nginx, Caddy eller Cloudflare
TRUST_PROXY=true

# --- Discord-innlogging (påkrevd) ---
# discord.com/developers/applications → din app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Discord-serveren din ---
# Høyreklikk på serveren i Discord (med utviklermodus på) → Kopier server-ID
DISCORD_GUILD_ID=
# true = bare medlemmer av Discord-serveren kan logge inn
REQUIRE_DISCORD_MEMBER=false
# Rolle-ID-er som gir staff-tilgang, kommaseparert
DISCORD_STAFF_ROLE_IDS=
# Rettigheter for alle med staff-rollen over (kommaseparert). Tom = tickets.view,tickets.close,apps.whitelist
# Mulige: tickets.view, tickets.close, apps.whitelist, apps.jobs, apps.staff, discord.manage, staff.manage
DISCORD_STAFF_ROLE_PERMS=
# Discord-ID-er som alltid er staff, kommaseparert (sett inn din egen her)
STAFF_DISCORD_IDS=
DISCORD_INVITE=https://discord.gg/dinkode

# --- Discord-bot: tickets i Discord og whitelist-rolle ---
# Boten starter når DISCORD_BOT_TOKEN, DISCORD_GUILD_ID og DISCORD_CLIENT_ID er satt
DISCORD_BOT_TOKEN=
# Kategorien der ticket-kanalene lages (høyreklikk på kategorien → Kopier ID)
DISCORD_TICKET_CATEGORY_ID=
# Rollen spillere får når whitelist-søknaden godkjennes (valgfritt)
DISCORD_WHITELIST_ROLE_ID=

# --- Valgfritt: varsler om nye søknader og tickets i en Discord-kanal ---
DISCORD_WEBHOOK_URL=

# --- FiveM ---
# Lag en lang tilfeldig nøkkel: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIVEM_API_KEY=
# Adressen til FiveM-serveren, brukes til spillertelleren (players.json)
FIVEM_SERVER_URL=http://123.45.67.89:30120
# Det spillerne skriver etter "connect" i F8
CONNECT_ADDRESS=play.novexrp.no

# --- Bakgrunnsvideo øverst på forsiden ---
# YouTube-ID (det etter watch?v=). Vises rett fra YouTube i beste kvalitet.
# La den stå tom (HERO_YOUTUBE_ID=) for å bruke public/video/hero.mp4 i stedet.
HERO_YOUTUBE_ID=Yaba1xgSJ2k
# Kreditering nederst i hjørnet, f.eks. "Film: Logic Films"
HERO_CREDIT=

# --- Valgfritt: YouTube-trailer på forsiden (bare ID-en, f.eks. dQw4w9WgXcQ) ---
YOUTUBE_TRAILER_ID=

# --- Database (standard: data/novex.db) ---
# DATABASE_FILE=/var/lib/novex/novex.db
